{
  "name": "nexlab-v2",
  "private": true,
  "workspaces": ["packages/*"],
  "scripts": {
    "build:shared": "npm run build -w @nexlab/shared",
    "dev:backend": "npm run dev -w backend",
    "dev:frontend": "npm run dev -w frontend",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\""
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}