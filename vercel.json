{
  "version": 2,
  "builds": [
    {
      "src": "packages/frontend/**",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "packages/frontend/dist"
      }
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/packages/frontend/index.html"
    }
  ]
}